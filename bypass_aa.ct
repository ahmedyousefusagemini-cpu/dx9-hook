01A543B0:
  dd 0

dealloc(cestubs)
unregistersymbol(cestubs)

// ============================================================
// Notes:
// - DLL slot math: base = DLL image base (0x10000000 preferred),
//   slot = base + 0x38350 + id*4. CE resolves "TqNDProtect.dll+.."
//   relative to the actually-loaded module base.
// - If the game was already running when you enable, TqNDProtect
//   may have cached real pointers in the slots; the [ENABLE]
//   overwrites them with the poison marker, so it still works.
// - Restart the game to restore original behavior.
// ============================================================
</AssemblerScript>
