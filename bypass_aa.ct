<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="33">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Conquer.exe + TqNDProtect.dll anti-debug/anti-CE bypass (memory-only)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>
// ============================================================
// Conquer.exe + TqNDProtect.dll + ndac.dll + Assist.dll
// — disable anti-debugging and anti-Cheat-Engine detection.
// Memory-only, reversible.
//
// PART 1 — EXE (Conquer.exe, base 0x00400000, no ASLR):
//   Login-dialog init checks (4x SoftICE device probes +
//   IsDebuggerPresent). On detection it calls
//   CDialog::EndDialog(this,0) = instant close.
//   -> NOP all 5 failure JNZs, force IsDebuggerPresent=0.
//
// PART 2 — TqNDProtect.dll anti-cheat API cache:
//   Pre-poison detection-API slots so try_get_function() returns
//   NULL for every detector call. (slot = DLLbase+0x38350+id*4)
//
// PART 3 — ndac.dll + Assist.dll delay-load IAT:
//   Redirect all delay-load IAT slots to no-op stubs so the
//   VMProtect anti-cheat DLLs never load.
// ============================================================

[ENABLE]

// ---------------- PART 1: Conquer.exe ----------------

// 4x SoftICE driver probes: JNZ -> NOP (never take fail branch)
00A22CB8:
  db 90 90 90 90 90 90
00A22CCB:
  db 90 90 90 90 90 90
00A22CDE:
  db 90 90 90 90 90 90
00A22CF1:
  db 90 90 90 90 90 90

// IsDebuggerPresent: force EAX=0 (not present)
00A22CF7:
  db 33 C0 90 90 90 90

// IsDebuggerPresent result branch: JNZ -> NOP
00A22D01:
  db 90 90 90 90 90 90

// ---------------- PART 2: TqNDProtect.dll ----------------
// Each entry is one dword (poison marker). Addresses are
// module-relative so they survive the DLL's actual load base.

TqNDProtect.dll+3835C:
  dd 44BF19B1        // id 0x003 IsDebuggerPresent
TqNDProtect.dll+38390:
  dd 44BF19B1        // id 0x010 CoCreateInstance
TqNDProtect.dll+38808:
  dd 44BF19B1        // id 0x12E FindClose
TqNDProtect.dll+3881C:
  dd 44BF19B1        // id 0x133 FindFirstFileExA
TqNDProtect.dll+3885C:
  dd 44BF19B1        // id 0x143 FindNextFileA
TqNDProtect.dll+38544:
  dd 44BF19B1        // id 0x0DD DeviceIoControl

// ---------------- PART 3: ndac.dll + Assist.dll delay-load IAT ----------------
// Conquer.exe .data IAT slot tables (absolute VAs, EXE base 0x400000, no ASLR).
// Redirect every slot to a no-op stub so these anti-cheat DLLs never load.
// ndac.dll:    IAT 0x01A54474, 26 ordinal imports
// Assist.dll:  IAT 0x01A54378, 15 slots

// Allocate an executable stub (xor eax,eax; ret) that all the above slots
// point at.
alloc(cestubs, 64)
cestubs:
  db 33 C0 C3 90 90 90 90 90
registersymbol(cestubs)

// Point every slot at the allocated stub.
01A54474:
  dd cestubs
01A54478:
  dd cestubs
01A5447C:
  dd cestubs
01A54480:
  dd cestubs
01A54484:
  dd cestubs
01A54488:
  dd cestubs
01A5448C:
  dd cestubs
01A54490:
  dd cestubs
01A54494:
  dd cestubs
01A54498:
  dd cestubs
01A5449C:
  dd cestubs
01A544A0:
  dd cestubs
01A544A4:
  dd cestubs
01A544A8:
  dd cestubs
01A544AC:
  dd cestubs
01A544B0:
  dd cestubs
01A544B4:
  dd cestubs
01A544B8:
  dd cestubs
01A544BC:
  dd cestubs
01A544C0:
  dd cestubs
01A544C4:
