<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="33">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Conquer.exe + TqNDProtect.dll anti-debug/anti-CE bypass (memory-only)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>
// ============================================================
// Conquer.exe + TqNDProtect.dll — disable anti-debugging
// and anti-Cheat-Engine detection. Memory-only, reversible.
//
// PART 1 — EXE (Conquer.exe, base 0x00400000, no ASLR):
//   Login-dialog init checks (4x SoftICE device probes +
//   IsDebuggerPresent). On detection it calls
//   CDialog::EndDialog(this,0) = instant close.
//   -> NOP all 5 failure JNZs, force IsDebuggerPresent=0.
//
// PART 2 — DLL (TqNDProtect.dll, self-decrypting anti-cheat):
//   The CE scanner is inside a runtime-decrypted blob and calls
//   all APIs through try_get_function() which caches resolved
//   pointers in a slot table at DLLbase+0x38350, indexed by
//   function_id, XOR-rotated with key 0xBB40E64E.
//   -> Pre-poison the detection-API cache slots with the
//      encoded "never resolve" marker 0x44BF19B1 so every
//      detector call returns NULL and is skipped.
//
//   Slots poisoned (id -> API):
//     0x003 -> IsDebuggerPresent
//     0x12E -> FindClose
//     0x133 -> FindFirstFileExA   (CE driver/file scan)
//     0x143 -> FindNextFileA      (CE driver/file scan)
//     0x0DD -> DeviceIoControl    (CE kernel driver detect)
//     0x10  -> CoCreateInstance   (WMI/process scan)
// ============================================================

[ENABLE]

// ---------------- PART 1: Conquer.exe ----------------

// 4x SoftICE driver probes: JNZ -> NOP (never take fail branch)
00A22CB8:
  db 90 90 90 90 90 90
00A22CCB:
  db 90 90 90 90 90 90
00A22CDE:
  db 90 90 90 90 90 90
00A22CF1:
  db 90 90 90 90 90 90

// IsDebuggerPresent: force EAX=0 (not present)
00A22CF7:
  db 33 C0 90 90 90 90

// IsDebuggerPresent result branch: JNZ -> NOP
00A22D01:
  db 90 90 90 90 90 90

// ---------------- PART 2: TqNDProtect.dll ----------------
// Each entry is one dword (poison marker). Addresses are
// module-relative so they survive the DLL's actual load base.

TqNDProtect.dll+3835C:
  dd 44BF19B1        // id 0x003 IsDebuggerPresent
TqNDProtect.dll+38390:
  dd 44BF19B1        // id 0x010 CoCreateInstance
TqNDProtect.dll+38808:
  dd 44BF19B1        // id 0x12E FindClose
TqNDProtect.dll+3881C:
  dd 44BF19B1        // id 0x133 FindFirstFileExA
TqNDProtect.dll+3885C:
  dd 44BF19B1        // id 0x143 FindNextFileA
TqNDProtect.dll+38544:
  dd 44BF19B1        // id 0x0DD DeviceIoControl

[DISABLE]

// ---------------- PART 1: Conquer.exe ----------------
00A22CB8:
  db 0F 85 B4 02 00 00
00A22CCB:
  db 0F 85 A1 02 00 00
00A22CDE:
  db 0F 85 8E 02 00 00
00A22CF1:
  db 0F 85 7B 02 00 00
00A22CF7:
  db FF 15 2C 52 4F 01
00A22D01:
  db 0F 85 6D 02 00 00

// ---------------- PART 2: TqNDProtect.dll ----------------
// Restore slots to 0 (empty = "resolve on demand"). The DLL
// will lazily re-resolve these APIs via GetProcAddress.
TqNDProtect.dll+3835C:
  dd 00000000
TqNDProtect.dll+38390:
  dd 00000000
TqNDProtect.dll+38808:
  dd 00000000
TqNDProtect.dll+3881C:
  dd 00000000
TqNDProtect.dll+3885C:
  dd 00000000
TqNDProtect.dll+38544:
  dd 00000000

// ============================================================
// Notes:
// - DLL slot math: base = DLL image base (0x10000000 preferred),
//   slot = base + 0x38350 + id*4. CE resolves "TqNDProtect.dll+.."
//   relative to the actually-loaded module base.
// - If the game was already running when you enable, TqNDProtect
//   may have cached real pointers in the slots; the [ENABLE]
//   overwrites them with the poison marker, so it still works.
// - Restart the game to restore original behavior.
// ============================================================
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
</CheatTable>
